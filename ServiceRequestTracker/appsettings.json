{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=service_requests;Username=postgres;Password=postgres"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "User": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "Exchange": "service-requests.events",
    "Queue": "service-requests.changed",
    "DeadLetterExchange": "service-requests.events.dlx",
    "DeadLetterQueue": "service-requests.changed.dlq",
    "RoutingKey": "service-request.changed"
  },
  "Outbox": {
    "PollInterval": "00:00:05",
    "BatchSize": 50,
    "InitialBackoff": "00:00:02",
    "MaxBackoff": "00:01:00",
    "PublishTimeout": "00:00:10"
  }
}